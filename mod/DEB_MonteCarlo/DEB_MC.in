MonteCarlo("DEB_MC.out", # output file
            200,          # nruns
            1215);       # random seed
            
Integrate(Lsodes, 1e-7, 1e-6, 0); 

Distrib (pAm,          TruncNormal_cv,        1172,      0.2,    800, 8000);
Distrib (pM,           TruncNormal_cv,         1600,      0.2,    0.01, 10000);
Distrib (kap,          Uniform,               0.05,     0.95);
Distrib (v,            Uniform,               0.0001,    0.5);
Distrib (Ehb,          TruncNormal_cv,         0.5,      0.2,    0.1, 10);
Distrib (Ehp,          TruncNormal_cv,         100,      0.2,    1, 1000);
Distrib (E_coc,        TruncNormal_cv,         200,      0.2,    50, 5000);
Distrib (rOM_ClxHorse, TruncNormal_cv,         0.2,      0.2,    0, 1);

############## Experiments ########################

Simulation { # Bart2019_XP1_1
    Init= 1;
    WeightSoilCosm = 400;
    Winit=0.01;
    OM_soil_t0=13;
    OM_horse_t0=2.7;
    Soil=1;
    Texp=15;
    Dens=1;
    OM_soil_replace=Events(OM_soil,
                          13,
                          0, 28, 56, 84, 112, 140, 168, 196, 224, 252, 280, 308, 336,
                          Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, 
                           13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13);
    OM_horse_replace=Events(OM_horse,
                           13,
                           0, 28, 56, 84, 112, 140, 168, 196, 224, 252, 280, 308, 336,
                           Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, Replace, 
                            2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7);
    OM_horse_add=Events(OM_horse,
                           13,
                           14, 42, 70, 98, 126, 154, 182, 210, 238, 266, 294, 322, 350,
                           Add, Add, Add, Add, Add, Add, Add, Add, Add, Add, Add, Add, Add, 
                            2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7, 2.7);
    PrintStep(Weight, 
		    Reproduction,
		    OM_horse,
		    OM_soil,
				0, 364, 0.1);
}
