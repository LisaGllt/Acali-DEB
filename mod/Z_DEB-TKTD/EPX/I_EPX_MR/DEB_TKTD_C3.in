MCMC( "DEB_TKTD_C3.out",  # output file
      "",                # name of restart file
      "",                # name of data file
      30000, 0,             # iterations, print prediction flag
      1, 10000,          # printing frequency, iters to print
      2222);               # random seed

Integrate (Lsodes,  1e-10, 1e-09, 0); # Integrate(Solver, RTOL, ATOL, ITOL);
    
Level{ # Global
    


Distrib (nec,          TruncNormal_cv,                50000,     0.5, 100, 10000000);
Distrib (b,            LogUniform,                0.0000001,          0.01);

# Calcul des vraissemblances
Distrib (Sigma_W, TruncNormal,  0.005, 1, 0.01, 100);
Likelihood (Weight,   Normal, Prediction(Weight), Sigma_W); 
Likelihood (Reproduction, Poisson, Prediction(Reproduction));

Level{

  ############## Experiments ###################
  

Experiment { # EPX_EC50_growth_Ctrl
    Init = 1;
    Ce0=0;
    Winit=0.10092;
    WeightSoilCosm = 200;
    OM_soil_t0=6.52;
    OM_horse_t0=2.7;
    Texp=18;
    Dens=1;
    OM_soil_replace=Events(OM_soil,
                          2,
                          0, 28,
                          Replace, Replace, 
                           6.52, 6.52);
    OM_horse_replace=Events(OM_horse,
                           2,
                           0, 28,
                           Replace, Replace, 
                            2.7, 2.7);
    OM_horse_add=Events(OM_horse,
                           1,
                           14,
                           Add, 
                            2.7);
    Print(Weight,0, 14, 28);
    Data(Weight,0.10092, 0.21477, 0.41118);
    Print(Reproduction,0, 14, 28);
    Data(Reproduction,0, 0, 0);
}
