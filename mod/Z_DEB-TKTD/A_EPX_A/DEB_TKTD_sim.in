#### DEB-TKTD A. caliginosa | Epoxiconazole
#===============================================

Integrate(Lsodes, 1E-6, 1E-6, 1);

########## Experiments ################################################

kr = 1;
nec = 1000;
b = 1;

Simulation { # EPX_EC50_growth_Ctrl
    Init = 1;
    Ce0=0;
    Winit=0.07212;
    OM_soil_t0=6.52;
    OM_horse_t0=2.7;
    Texp=18;
    Dens=1;
    OM_soil_replace=Events(OM_soil,
                          2,
                          0, 28,
                          Replace, Replace, 
                           6.52, 6.52);
    OM_horse_replace=Events(OM_horse,
                           2,
                           0, 28,
                           Replace, Replace, 
                            2.7, 2.7);
    OM_horse_add=Events(OM_horse,
                           1,
                           14,
                           Add, 
                            2.7);
    PrintStep(Weight,
              Reproduction, Stress, Damage, Ci, Ce,
				      0, 28, 0.01);
}
