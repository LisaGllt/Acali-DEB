#### DEB TKTD A. caliginosa
#===============================================

SetPoints("DEB_setpoint_predobs_13.out", "tab_setpoint.out", 0,);

Integrate(Lsodes, 1E-6, 1E-6, 1);

########## Experiments ################################################

Simulation { # MIX_F6
    Init = 2;
    Ce0_IMD=206.4;
    Ce0_EPX=223369.8;
    Winit=0.506641428571429;
    WeightSoilCosm = 200;
    OM_soil_t0=6.52;
    OM_horse_t0=5.4;
    Texp=18;
    Dens=NDoses(3,
                2, -1, 2,
                0, 14, 28);
    OM_soil_replace=Events(OM_soil,
                          4,
                          0, 0, 28, 28,
                          Replace, Replace, Replace, Replace, 
                           6.52, 6.52, 6.52, 6.52);
    OM_horse_replace=Events(OM_horse,
                           4,
                           0, 0, 28, 28,
                           Replace, Replace, Replace, Replace, 
                            5.4, 5.4, 5.4, 5.4);
    OM_horse_add=Events(OM_horse,
                           1,
                           14,
                           Add, 
                            5.4);
                               
    Print(Weight,0, 0, 14, 28, 28);
    Print(Reproduction,0, 0, 14, 28, 28);
}

  End.
