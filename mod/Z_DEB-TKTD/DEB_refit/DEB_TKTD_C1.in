    OM_soil_replace=Events(OM_soil,
                          2,
                          0, 28,
                          Replace, Replace, 
                           6.52, 6.52);
    OM_horse_replace=Events(OM_horse,
                           2,
                           0, 28,
                           Replace, Replace, 
                            2.7, 2.7);
    OM_horse_add=Events(OM_horse,
                           1,
                           14,
                           Add, 
                            2.7);
    Print(Weight,0, 14, 28);
    Data(Weight,0.10092, 0.21477, 0.41118);
    Print(Reproduction,0, 14, 28);
