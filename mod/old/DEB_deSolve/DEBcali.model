# DEB Apporectodea caliginosa
# -----------------------------------------------------------------------

States = {E,         # Energy in the reserve (J)
          L,         # Structural volumetric length (cm)
          Eh,        # Maturity (J)
          R,         # Cumulated reproduction (# of cocoons produced)
          OM_soil,   # OM soil quantity in cosm (for Dens earthworms) (g)
          OM_horse,  # OM horse dung quantity in cosm (for Dens earthworms) (g)
          W, 
          OM};

Outputs = {Energy,             # Energy in the reserve (J)
          Maturity,            # Maturity (J)
          Reproduction,        # Cumulated reproduction (# of cocoons produced)
		      Weight,
		      Organic_matter};             # Wet weight of the earthworm (g)
		   
Inputs = {Dens};              # Number of earthworm in the cosm (#)

# Error parameters
#  Sigma_W; # Error on Weight
#  Sigma_R; # Error on Reproduction

# PARAMETERS ---------------------------------------------------------------

# Environment
muOM;             # Energy in 1 g of organic matter from horse dung (J/g) 0.9 * 13000
rOM_ClxHorse;     # Ratio of energy in 1 g of OM from soil vs 1 g of OM from horse dung

# Energy assimilation
Fm;               # [F_m], max spec searching rate (g/d.g)
kapX;             # digestion efficiency of food to reserve (-)
pAm;              # {p_Am}, spec assimilation flux (J/d.cm^2)
 # r_pAm_pM = 1.5;   # Ratio between pAm and pM (pM = pAm * r_pAm_pM)
v;     # energy conductance (cm/d)

kap;              # allocation fraction to soma (-)
# kapA;             # allocation fraction of energy to soma after puberty (-)

# Maintenance and growth
pM;               # [p_M], vol-spec somatic maint (J/d.cm^3)
pT;               # {p_T}, surf-spec somatic maint (J/d.cm^2)
Eg;               # [E_G], spec cost for structure (J/cm^3)
Shape;            # shape coefficient (-)
w;                # Contribution of reserve to body weight (g/cm^3)

# Maturity
kJ;               # maturity maint rate coefficient (1/d)
Ehb;              # maturity at birth (J)
Ehp;              # maturity at puberty (J)

# Reproduction
L_coc;     # Structural length of a cocoon (cm)
E_coc;      # Energy in a cocoon (J)
# UE0 = 0.078;      # Scaled cost of an egg (cm^2/d)
kapR;     # reproduction efficiency (-)

# Metabolic response to T
TAH;      # Arrhenius temperature for upper boundary (K)
TH;       # upper boundary (K)
TA;        # Arrhenius temperature (K)
Tref;    # Reference temperature (K)

Winit;
Texp;
WeightSoilCosm;

Initialize{

      kapreal = (Eh < Ehp ? kap : (Dens > 1 ? (1-kap) : kap)); # must be defined before g
    	
    	# Coefficient for temperature correction (Texp in °C)
    	sA = exp(TA/Tref-TA/(Texp+273.15));
      srH = (1 + exp(TAH/TH-TAH/Tref))/(1+exp(TAH/TH-TAH/(Texp+273.15)));
    	Tc  = sA*((Texp+273.15>=Tref)*srH + (Texp+273.15<Tref));
    	
    # Correction of coefficients depending on temperature
      pAm_t  = pAm * Tc;        
      v_t    = v   * Tc;
      kJ_t   = kJ * Tc;
      
    # Primary parameters          
      Km = pM / Eg ;
      Km_t = Km * Tc;
      Em = pAm / v ;
      g = Eg / (kapreal * Em);
      Lm = (v / (Km*g));

    # Starting points
      E = Em;
      L = pow((Winit/(1+1*w)),(1.0/3.0)); # E/Em = 1. Winit en g ! IL FAUT METTRE DES POINTS SINON C'EST DES INT ET PAS DES FLOAT
      Weight = Winit;
      Eh = Ehb;
      R = 1e-6;
      freal = 1;
    
} # End of Initialize


Dynamics{

    # Coefficient for temperature correction (Texp in °C)
    	sA = exp(TA/Tref-TA/(Texp+273.15));
      srH = (1 + exp(TAH/TH-TAH/Tref))/(1+exp(TAH/TH-TAH/(Texp+273.15)));
    	Tc  = sA*((Texp+273.15>=Tref)*srH + (Texp+273.15<Tref));
    	
    # Correction of coefficients depending on temperature
      pAm_t  = pAm * Tc;        
      v_t    = v   * Tc;
      kJ_t   = kJ * Tc;
      
      kapreal = (Eh < Ehp ? kap : (Dens > 1 ? (1-kap) : kap));
      
    # Primary parameters          
      Km = pM / Eg ;
      Km_t = Km * Tc;
      Em = pAm / v ;
      g = Eg / (kapreal * Em);
      Lm = (v / (Km*g));
      
    
    # Energie assimilation
      
      # Maximal energy ingested by the earthworm (J/d)
      Qfmax = pAm_t * pow(L,2)/kapX;                          
      
      # Energy ingested by the earthworm per day (J/d)
      Qf_soil = Fm * Weight*(muOM * rOM_ClxHorse * OM_soil/Dens); 
      Qf_horse = Fm * Weight*(muOM * OM_horse/Dens);   
      Qf = Qf_soil + Qf_horse;
      
      # Quantity of organic matter consummed by all earthworms in one cosm per day (g/d)
      OM_soil_out = (Qf_soil/(muOM*rOM_ClxHorse))*Dens;   
      OM_horse_out = (Qf_horse/muOM)*Dens; # gOM/cosm/d   
      
      # Dynamics of organic matter in the cosm (which cannot be negative)
      dt(OM_horse) = ((OM_horse - OM_horse_out) < 1e-12 ? (- OM_horse) : (- OM_horse_out));
      dt(OM_soil) = ((OM_soil- OM_soil_out) < 1e-12 ? (- OM_soil) : (- OM_soil_out));
      
      OM = OM_soil + OM_horse;
      
      # Functional response of the earthworm to organic matter
      X = Qf/(0.5*Qfmax);
      freal = X/(1+X);
      
    # Energy in the reserve (which cannot be negative)
    
      tmp_E = (pAm_t/L)*(freal-E/Em);
      dt(E) = (E < 1e-12 ? (-E) : tmp_E);

    # Structural length
    
      dt(L) = (v_t / (3 * ( ( (E/Em) + g) ) ) ) * ((E/Em) - (L/Lm));
      W = pow(L,3)*(1 + E/Em*w);

    # Maturity
    
      pC       = ( (g * E ) / (g + (E/Em)) ) * ((v_t*pow(L,2)) + (Km_t*pow(L,3)));
      tmp_Eh   = ((1-kapreal) * pC) - (kJ_t* Eh);
      dt(Eh)   = (Eh < Ehp ? tmp_Eh : 0);

    # Reproduction
    
      tmp_R    = kapR * ( ((1-kapreal)*pC) - (kJ_t*Ehp));
  	  dt(R)    = (Eh >= Ehp ? tmp_R/(E_coc) : 0);

} # End of Dynamics

CalcOutputs{
    Energy = E;
    Maturity = (Eh <= 0 ? 1E-9 : Eh); 
    Reproduction = (R <= 0 ? 1E-9 : R);
    Weight = W; 
    Organic_matter = OM;
}

End.