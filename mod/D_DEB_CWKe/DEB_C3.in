MCMC( "DEB_C3.out",  # output file
      "",                # name of restart file
      "",                # name of data file
      100000, 0,             # iterations, print prediction flag
      1, 10000,          # printing frequency, iters to print
      1223);               # random seed

Integrate (Lsodes,  1e-07, 1e-06, 0); # Integrate(Solver, RTOL, ATOL, ITOL);
    
Level{ # Global
    

Distrib (Fm,           LogUniform,         0.0001,      0.3);
Distrib (pAm,          TruncNormal_cv,        100,      0.2,      40,    2000);
Distrib (r_pAm_pM,     TruncNormal_cv,        0.8,      0.1,     0.1,       2);
Distrib (v,            TruncNormal_cv,    0.18505,      0.1,   0.001,       2);
Distrib (kapJ,         Uniform,                 0,        1);
Distrib (kapA,         Uniform,                 0,        1);
Distrib (Ehp,          TruncNormal_cv,        100,      0.2,      20,     300);
Distrib (E_coc,        TruncNormal_cv,         30,      0.2,       1,     300);
Distrib (rOM_ClxHorse, LogUniform,        0.00001,      0.3);
Distrib (K,            Uniform,            0.0001,        1);
Distrib (dv,           TruncNormal_cv,          1,      0.05,       0,      4);
Distrib (de,           LogUniform,     0.000000001,     0.1);
Distrib (tau,          TruncNormal_cv,          7,      0.5,       0,      50);

# Calcul des vraissemblances
Distrib (Sigma_W, TruncNormal,  5, 1, 0.01, 100);
Likelihood (Weight,   Normal, Prediction(Weight), Sigma_W);  
Likelihood (Reproduction, Poisson, Prediction(Reproduction));

Level{

  ############## Experiments ###################
  

Experiment { # Bart2019_XP1_1
    Init= 1;
    WeightSoilCosm = 400;
    Winit=0.01;
    OM_soil_t0=13;
    OM_horse_t0=2.7;
    Soil=1;
    Texp=15;
    Dens=1;
    OM_soil_replace=Events(OM_soil,
                          4,
                          0, 28, 56, 84,
                          Replace, Replace, Replace, Replace, 
                           13, 13, 13, 13);
    OM_horse_replace=Events(OM_horse,
                           4,
                           0, 28, 56, 84,
                           Replace, Replace, Replace, Replace, 
                            2.7, 2.7, 2.7, 2.7);
    OM_horse_add=Events(OM_horse,
                           3,
                           14, 42, 70,
                           Add, Add, Add, 
                            2.7, 2.7, 2.7);
    Print(Weight,0, 14, 28, 42, 56, 70, 84);
    Data(Weight,0.01, 0.0210666666666667, 0.0464333333333333, 0.0906333333333333, 0.195433333333333, 0.391666666666667, 0.5368);
    Print(Reproduction,0, 14, 28, 42, 56, 70, 84);
    Data(Reproduction,0, -1, 0, -1, 0, -1, 0);
}
